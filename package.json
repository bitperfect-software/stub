{
    "name": "@bitperfect-software/stub",
    "version": "0.1.0",
    "description": "Stack-agnostic stub generator: turns your own LiquidJS templates into project-specific CLI commands",
    "keywords": [
        "cli",
        "generator",
        "code-generator",
        "codegen",
        "scaffold",
        "scaffolding",
        "boilerplate",
        "stub",
        "template",
        "liquid",
        "liquidjs"
    ],
    "license": "GPL-3.0-or-later",
    "author": "bitperfect GmbH (https://bitperfect.at)",
    "homepage": "https://bitperfect-software.github.io/stub/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitperfect-software/stub.git"
    },
    "bugs": {
        "url": "https://github.com/bitperfect-software/stub/issues"
    },
    "type": "module",
    "bin": {
        "stub": "./dist/index.js"
    },
    "exports": {
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@11.9.0",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist/index.js --external:change-case --external:commander --external:liquidjs --external:pluralize --external:zod && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "coverage": "vitest run --project unit --coverage",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.ts\" \".github/**/*.yml\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.ts\" \".github/**/*.yml\"",
        "check:all": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
        "prepack": "pnpm run build",
        "prepublishOnly": "pnpm run check:all"
    },
    "dependencies": {
        "change-case": "^5.4.4",
        "commander": "^15.0.0",
        "liquidjs": "^10.30.0",
        "pluralize": "^8.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.12.0",
        "@types/pluralize": "^0.0.33",
        "@vitest/coverage-v8": "^5.0.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.3"
    }
}
